# Required for LLM-powered features. Get one at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=YOUR_CURSOR_API_KEY

# Optional: change the API port (default 5278).
# PORT=5278

# ── Logging ────────────────────────────────────────────────────────────
# Server logs go to stdout, which ./start.sh captures in .logs/server.log

# error | warn | info | debug | trace   (default: info)
# debug adds per-call cost accounting, pipeline scheduling decisions,
# SSE connect/disconnect, and background-task timing.
# LOG_LEVEL=info

# pretty | json   (default: pretty)
# LOG_FORMAT=pretty

# How much of each prompt sent to the model is logged.
# off | preview | full   (default: preview)
# LOG_PROMPTS=preview

# How much of each model response is logged.
# off | preview | full   (default: preview)
# LOG_RESPONSES=preview

# Characters kept per payload when the mode is `preview` (default: 1200).
# LOG_PREVIEW_CHARS=1200

# Force ANSI colour on/off. Defaults to on only when stdout is a terminal,
# so the log file stays clean.
# LOG_COLOR=0

# NOTE: Specialist identities, models, tone, and model parameters are
# configured from the UI (My Team tab) and persisted in your browser's
# localStorage. There are no server-side model defaults to set here.
